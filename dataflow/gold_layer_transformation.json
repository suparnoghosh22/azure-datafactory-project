{
	"name": "gold_layer_transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "DimAirline"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "DimFlight"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "FactBookings"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "FactBookings1"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "sinkGoldLayerTopAirlines"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeStoragePro",
						"type": "LinkedServiceReference"
					},
					"name": "sinkGoldLayerFlight"
				}
			],
			"transformations": [
				{
					"name": "FactBookingsjoinAirline"
				},
				{
					"name": "selectColumnsFromJoinedTable"
				},
				{
					"name": "groupByAirlineGetMaxRevenue"
				},
				{
					"name": "rankByBestRevenueGenerated"
				},
				{
					"name": "filterTop5Airlines"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "bookingsJoinFlight"
				},
				{
					"name": "selectColumnsFrom"
				},
				{
					"name": "aggregateByFlightId"
				},
				{
					"name": "sortByPassengers"
				},
				{
					"name": "filterByMoreThan400"
				},
				{
					"name": "alterRow2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirline') ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_timestamp as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimFlight') ~> DimFlight",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBookings') ~> FactBookings",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as integer,",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: true,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBookings') ~> FactBookings1",
				"FactBookings, DimAirline join(FactBookings@airline_id == DimAirline@airline_id,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> FactBookingsjoinAirline",
				"FactBookingsjoinAirline select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id,",
				"          airline_id = FactBookings@airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          airline_name,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumnsFromJoinedTable",
				"selectColumnsFromJoinedTable aggregate(groupBy(airline_name),",
				"     total_revenue = sum(ticket_cost)) ~> groupByAirlineGetMaxRevenue",
				"groupByAirlineGetMaxRevenue window(desc(total_revenue, true),",
				"     rankings = denseRank()) ~> rankByBestRevenueGenerated",
				"rankByBestRevenueGenerated filter(rankings < 6) ~> filterTop5Airlines",
				"filterTop5Airlines alterRow(insertIf(1==1)) ~> alterRow1",
				"FactBookings1, DimFlight join(FactBookings1@flight_id == DimFlight@flight_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> bookingsJoinFlight",
				"bookingsJoinFlight select(mapColumn(",
				"          booking_id,",
				"          passenger_id,",
				"          flight_id = FactBookings1@flight_id,",
				"          airline_id,",
				"          origin_airport_id,",
				"          destination_airport_id,",
				"          booking_date,",
				"          ticket_cost,",
				"          flight_duration_mins,",
				"          checkin_status,",
				"          flight_number,",
				"          departure_timestamp,",
				"          arrival_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectColumnsFrom",
				"selectColumnsFrom aggregate(groupBy(flight_id),",
				"     total_passengers_per_flight = sum(passenger_id)) ~> aggregateByFlightId",
				"aggregateByFlightId sort(desc(total_passengers_per_flight, true),",
				"     caseInsensitive: true) ~> sortByPassengers",
				"sortByPassengers filter(total_passengers_per_flight > 400) ~> filterByMoreThan400",
				"filterByMoreThan400 alterRow(insertIf(1==1)) ~> alterRow2",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'gold',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     keys:['airline_name'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkGoldLayerTopAirlines",
				"alterRow2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Fastest',",
				"     fileSystem: 'gold',",
				"     overwrite: true,",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     keys:['flight_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkGoldLayerFlight"
			]
		}
	}
}